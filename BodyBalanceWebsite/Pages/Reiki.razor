@page "/services/reiki"

<PageTitle>Reiki Sessions &amp; Pricing | Entwined &amp; Unwind</PageTitle>

<section class="hero">
    <div class="container">
        <div class="hero-copy">
            <h1 class="brand-stack">
                Return to Self
                <span class="sub">Reiki</span>
            </h1>
            <div class="hero-rule"></div>
            <p class="tagline">
                Gentle energy healing to help you release what no longer serves you,
                restore balance, and reconnect with your authentic self.
            </p>
        </div>
        <div class="hero-art" role="img" aria-label="A lit candle beneath an olive branch, warm sunlight casting shadows on a navy wall"></div>
    </div>
</section>

<section class="benefits">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">Reiki Can Help You</span>
        </div>
        <div class="benefits-grid">
            <div class="benefit">
                <div class="benefit-icon">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="12" cy="3" r="0.65" fill="currentColor" /><path d="M12 21C6.5 18 7 10.5 12 6c5 4.5 5.5 12 0 15Zm0 0C5.5 21 1.5 15.5 3.5 9.5c2.1 0 3.7.5 5.1 1.5M12 21c6.5 0 10.5-5.5 8.5-11.5-2.1 0-3.7.5-5.1 1.5M12 21v-5" stroke="currentColor" stroke-width="0.85" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </div>
                <h3>Relax</h3>
                <p>Calm your body and mind</p>
            </div>
            <div class="benefit">
                <div class="benefit-icon">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M7 7.5c6-4.5 9 1.5 14 0M2 14c7-9 15 5 21-6M4.5 16c5-2.5 7.5 5.5 15.5-.5" stroke="currentColor" stroke-width="0.85" stroke-linecap="round" /></svg>
                </div>
                <h3>Release</h3>
                <p>Let go of stress and emotional tension</p>
            </div>
            <div class="benefit">
                <div class="benefit-icon">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="0.85" /><circle cx="12" cy="12" r="0.9" fill="currentColor" /></svg>
                </div>
                <h3>Recenter</h3>
                <p>Return to balance and presence</p>
            </div>
            <div class="benefit">
                <div class="benefit-icon">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="12" cy="3.5" r="2.1" stroke="currentColor" stroke-width="0.85" /><path d="M12 22c-2-2.5-8-7.2-8-11 0-4.5 5.5-6 8-2.1 2.5-3.9 8-2.4 8 2.1 0 3.8-6 8.5-8 11Z" stroke="currentColor" stroke-width="0.85" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </div>
                <h3>Reconnect</h3>
                <p>Deepen your connection with yourself</p>
            </div>
        </div>
        <div class="benefits-cta">
            <a class="btn btn-navy" href="schedule">
                Schedule Now
                <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
        </div>
    </div>
</section>

<section class="journey">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">Your Healing Journey</span>
            <h2>What to Expect</h2>
        </div>
        <div class="journey-steps">
            <div class="journey-step">
                <div class="journey-step-number">1</div>
                <h3>Book Your Session</h3>
                <p>Choose a time that works for you.</p>
            </div>
            <div class="journey-step">
                <div class="journey-step-number">2</div>
                <h3>Set Your Intention</h3>
                <p>We'll take a few moments to connect and explore what you'd like support with.</p>
            </div>
            <div class="journey-step">
                <div class="journey-step-number">3</div>
                <h3>Receive Reiki</h3>
                <p>Relax as you receive a soothing, intuitive energy healing session.</p>
            </div>
            <div class="journey-step">
                <div class="journey-step-number">4</div>
                <h3>Feel the Benefits</h3>
                <p>Experience greater clarity, balance, and alignment in your life.</p>
            </div>
        </div>
    </div>
</section>

<section class="content-section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">Session Options &amp; Pricing</span>
            <h2>Reiki Sessions</h2>
            <p>Tuesday &ndash; Saturday, 10 AM &ndash; 6 PM Central Time. Please request your session at least 48 hours in advance.</p>
        </div>
        <div class="services-grid">
            <div class="service-card">
                <div class="benefit-icon">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 20c-5-2-7-6-7-10 4 0 6 2 7 5 1-3 3-5 7-5 0 4-2 8-7 10Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>
                </div>
                <h3>30-Minute Reiki</h3>
                <p>A shorter session designed for relaxation, grounding, and creating space to reconnect with yourself.</p>
                <span class="service-price">30 min &middot; $44 for first-time clients</span>
                <p>Regular price $55 for returning clients.</p>
            </div>
            <div class="service-card">
                <div class="benefit-icon">
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4.3" stroke="currentColor" stroke-width="1.3" /><path d="M12 3v2.2M12 18.8V21M21 12h-2.2M5.2 12H3M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6M18.4 18.4l-1.6-1.6M7.2 7.2 5.6 5.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
                </div>
                <h3>60-Minute Reiki</h3>
                <p>A full Reiki session allowing more time to slow down, settle in, and explore what may be coming up emotionally, mentally, or energetically.</p>
                <span class="service-price">60 min &middot; $77 for first-time clients</span>
                <p>Regular price $111 for returning clients.</p>
            </div>
            <div class="service-card">
                <div class="benefit-icon">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.3" /><ellipse cx="12" cy="12" rx="4" ry="9" stroke="currentColor" stroke-width="1.3" /><path d="M3 12h18" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
                </div>
                <h3>30-Minute Distance Reiki</h3>
                <p>A Reiki session offered remotely, so you can take time to relax and reconnect from the comfort of your own space.</p>
                <span class="service-price">30 min &middot; $44</span>
            </div>
        </div>
        <p>In-person sessions are in Leavenworth; the exact address will be confirmed. Distance Reiki sessions are offered remotely. Appointment requests require Mary's approval.</p>
    </div>
</section>

<section class="content-section alt" style="text-align:center">
    <div class="container">
        <div class="section-heading" style="margin-bottom:1.5rem">
            <span class="eyebrow">Not Sure Where to Start?</span>
            <h2>Let's Find the Right Session for You</h2>
        </div>
        <a class="btn btn-navy" href="schedule">
            Schedule Now
            <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
    </div>
</section>
