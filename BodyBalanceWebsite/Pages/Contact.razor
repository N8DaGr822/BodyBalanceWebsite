@page "/contact"

@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@implements IDisposable
@inject HttpClient Http
@inject IConfiguration Configuration

<PageTitle>Contact | Return to Self Reiki</PageTitle>

<section class="page-hero">
    <div class="container">
        <span class="eyebrow eyebrow--on-navy">Contact</span>
        <h1>Contact Us</h1>
        <p>Send a message to the practice. To request an appointment, visit the <a href="schedule">session calendar</a>.</p>
    </div>
</section>

<section class="content-section">
    <div class="container">
        <div class="contact-layout">
            <div>
                @if (submitted)
                {
                    <div class="faq-item" style="border:none">
                        <h3>Thank you!</h3>
                        <p>Your message has been received. We'll reply using the contact details you provided.</p>
                        <p>Your message reference: <strong>@requestId</strong></p>
                    </div>
                }
                else
                {
                    @if (string.IsNullOrWhiteSpace(apiBaseUrl))
                    {
                        <p class="calendar-notice" role="status">Online messaging is not available on this site yet. The form cannot send messages until it is connected.</p>
                    }
                    <EditForm Model="model" OnValidSubmit="Submit" class="booking-form">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <fieldset disabled="@(submitting || retryPending)">
                            <legend>Send us a message</legend>
                            <div class="contact-form">
                                <div>
                                    <label for="name">Name</label>
                                    <InputText id="name" @bind-Value="model.Name" maxlength="150" autocomplete="name" placeholder="Your name" />
                                </div>
                                <div>
                                    <label for="email">Email</label>
                                    <InputText id="email" type="email" @bind-Value="model.Email" maxlength="254" autocomplete="email" placeholder="you@email.com" />
                                </div>
                                <div>
                                    <label for="phone">Phone (optional)</label>
                                    <InputText id="phone" type="tel" @bind-Value="model.Phone" maxlength="30" autocomplete="tel" />
                                </div>
                                <div>
                                    <label for="message">Message</label>
                                    <InputTextArea id="message" @bind-Value="model.Message" maxlength="4000" placeholder="How can we help?" />
                                </div>
                            </div>
                        </fieldset>
                        @if (!string.IsNullOrEmpty(error))
                        {
                            <p class="calendar-notice" role="alert">@error</p>
                        }
                        <button type="submit" class="btn btn-navy" disabled="@(submitting || string.IsNullOrWhiteSpace(apiBaseUrl))">
                            @(submitting ? "Sending..." : retryPending ? "Retry this message" : "Send Message")
                            <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </button>
                    </EditForm>
                }
            </div>

            <div class="contact-details">
                <h3>Get in Touch</h3>
                <div class="contact-detail-item">
                    <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.3" /><path d="m4 6.5 8 6 8-6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    <div>
                        <strong>Email</strong>
                        <span>hello@returntoselfreiki.com</span>
                    </div>
                </div>
                <div class="contact-detail-item">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M4 5c0 8 7 15 15 15l2-4-5-2-1.5 1.5A12 12 0 0 1 9 10.5L10.5 9 8.5 4 4 5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>
                    <div>
                        <strong>Phone</strong>
                        <span>(555) 123-4567</span>
                    </div>
                </div>
                <div class="contact-detail-item">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 21s7-6.4 7-11.5A7 7 0 0 0 5 9.5C5 14.6 12 21 12 21Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /><circle cx="12" cy="9.5" r="2.3" stroke="currentColor" stroke-width="1.3" /></svg>
                    <div>
                        <strong>Studio Location</strong>
                        <span>By appointment &middot; in-studio &amp; distance sessions</span>
                    </div>
                </div>
                <div class="contact-detail-item">
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.3" /><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
                    <div>
                        <strong>Hours</strong>
                        <span>Tuesday &ndash; Saturday, 10am &ndash; 6pm</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private readonly ContactDetails model = new();
    private readonly CancellationTokenSource cancellation = new();
    private Guid requestId = Guid.NewGuid();
    private string? apiBaseUrl;
    private string? error;
    private bool submitted;
    private bool submitting;
    private bool retryPending;
    private bool disposed;

    protected override void OnInitialized() => apiBaseUrl = Configuration["ScheduleApiBaseUrl"];

    private async Task Submit()
    {
        if (submitting || submitted || string.IsNullOrWhiteSpace(apiBaseUrl)) return;
        submitting = true;
        error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync($"{apiBaseUrl.TrimEnd('/')}/contact-messages",
                new { requestId, model.Name, model.Email, model.Phone, model.Message }, cancellation.Token);
            if (disposed) return;
            if (response.IsSuccessStatusCode)
            {
                var receipt = await response.Content.ReadFromJsonAsync<ContactReceipt>(cancellation.Token);
                if (receipt?.RequestId != requestId) throw new JsonException("Missing message receipt.");
                submitted = true;
                retryPending = false;
            }
            else if (response.StatusCode is System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.Conflict or System.Net.HttpStatusCode.RequestEntityTooLarge)
            {
                error = (await response.Content.ReadFromJsonAsync<ApiError>(cancellation.Token))?.Error ?? "Please check your message and contact details.";
                retryPending = false;
                requestId = Guid.NewGuid();
            }
            else SetUnknown();
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException)
        {
            if (!disposed) SetUnknown();
        }
        finally { submitting = false; }
    }

    private void SetUnknown()
    {
        // Retry Safety: Keep the original message and reference after an uncertain server response.
        retryPending = true;
        error = "We couldn't confirm whether your message was received. Retry this message before sending another one.";
    }

    public void Dispose() { disposed = true; cancellation.Cancel(); cancellation.Dispose(); }

    private sealed class ContactDetails
    {
        [Required, StringLength(150)] public string Name { get; set; } = "";
        [Required, EmailAddress, StringLength(254)] public string Email { get; set; } = "";
        [StringLength(30)] public string? Phone { get; set; }
        [Required, StringLength(4000)] public string Message { get; set; } = "";
    }
    private sealed record ContactReceipt(Guid RequestId);
    private sealed record ApiError(string Error);
}
