<section class="content-section alt">
    <div class="container" style="text-align:center">
        <div class="section-heading" style="margin-bottom:1.5rem">
            <span class="eyebrow">Ready When You Are</span>
            <h2>Let's Begin Your Healing Journey</h2>
        </div>
        <a class="btn btn-navy" href="schedule">
            Schedule Now
            <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
    </div>
</section>

@code {
    private bool reviewsOpen;
    private bool focusReviews;
    private ElementReference reviewsToggle;
    private ElementReference reviewsClose;

    // Testimonials: Replace fictional test content with approved client quotes before launch.
    private readonly (string Quote, string Name)[] testimonials =
    [
        ("I felt welcome from the moment I arrived. Mary explained what to expect and gave me plenty of time to settle in. The quiet space was a lovely pause in a busy week.", "Alex — Sample review"),
        ("Leslie listened patiently and made sure I felt comfortable asking questions. I appreciated the thoughtful pace and the warm, welcoming atmosphere throughout my visit.", "Jordan — Sample review"),
        ("This was my first Reiki session, and I wasn't sure what to expect. Everything was explained clearly, and I never felt rushed. I enjoyed having time set aside just for myself.", "Taylor — Sample review"),
        ("Booking was straightforward, and the session felt personal from start to finish. I especially appreciated being asked about my preferences and having space to share what brought me in.", "Morgan — Sample review"),
        ("The room was peaceful and inviting. Mary checked in with me and made it easy to relax into the experience. It was a thoughtful, gentle way to take a break from my usual routine.", "Casey — Sample review"),
        ("I appreciated Leslie's kindness and attention. There was time for questions before and after the session, and I left feeling heard. The entire visit felt welcoming and unhurried.", "Riley — Sample review")
    ];

    private async Task ToggleReviews()
    {
        if (reviewsOpen)
        {
            await CloseReviews();
            return;
        }

        reviewsOpen = true;
        focusReviews = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Drawer Focus: Wait until the close button exists before moving keyboard focus.
        if (focusReviews)
        {
            focusReviews = false;
            await reviewsClose.FocusAsync(preventScroll: true);
        }
    }

    private async Task CloseReviews()
    {
        reviewsOpen = false;
        focusReviews = false;
        await reviewsToggle.FocusAsync(preventScroll: true);
    }

    private async Task HandleReviewsKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && reviewsOpen)
        {
            await CloseReviews();
        }
    }
}
