    </div>
</section>

<section class="content-section alt">
    <div class="container" style="text-align:center">
        <div class="section-heading" style="margin-bottom:1.5rem">
            <span class="eyebrow">Ready When You Are</span>
            <h2>Let's Begin Your Healing Journey</h2>
        </div>
        <a class="btn btn-navy" href="schedule">
            Schedule Now
            <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
    </div>
</section>
