@page "/services"

<PageTitle>Services | Return to Self Reiki</PageTitle>

<section class="page-hero">
    <div class="container">
        <span class="eyebrow eyebrow--on-navy">Services</span>
        <h1>Sessions to Support Your Journey</h1>
        <p>Each session is tailored to what you need in that moment &mdash; release, rest, or realignment.</p>
    </div>
</section>

<section class="content-section">
    <div class="container">
        <div class="services-grid">
            <div class="service-card">
                <div class="benefit-icon">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 20c-5-2-7-6-7-10 4 0 6 2 7 5 1-3 3-5 7-5 0 4-2 8-7 10Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>
                </div>
                <h3>Introductory Session</h3>
                <p>A gentle first step &mdash; an introduction to Reiki and a chance to feel what energy healing can offer you.</p>
                <span class="service-price">45 min &middot; $65</span>
            </div>
            <div class="service-card">
                <div class="benefit-icon">
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4.3" stroke="currentColor" stroke-width="1.3" /><path d="M12 3v2.2M12 18.8V21M21 12h-2.2M5.2 12H3M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6M18.4 18.4l-1.6-1.6M7.2 7.2 5.6 5.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
                </div>
                <h3>Full Energy Healing Session</h3>
                <p>A complete Reiki session to release stuck energy, restore balance, and support whole-body relaxation.</p>
                <span class="service-price">60 min &middot; $90</span>
            </div>
            <div class="service-card">
                <div class="benefit-icon">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M16.5 4.5a8 8 0 1 0 3 12.4A9 9 0 0 1 16.5 4.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>
                </div>
                <h3>Deep Reconnection Session</h3>
                <p>An extended session combining Reiki with intuitive guidance for deeper clarity and alignment.</p>
                <span class="service-price">90 min &middot; $130</span>
            </div>
            <div class="service-card">
                <div class="benefit-icon">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M3 9c2-2 4-2 6 0s4 2 6 0 4-2 6 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /><path d="M3 15c2-2 4-2 6 0s4 2 6 0 4-2 6 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
                </div>
                <h3>Distance Reiki</h3>
                <p>Energy healing has no boundaries &mdash; receive a full session remotely, wherever you are.</p>
                <span class="service-price">60 min &middot; $75</span>
            </div>
            <div class="service-card">
                <div class="benefit-icon">
                    <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="8" stroke="currentColor" stroke-width="1.3" /><path d="M9 12h6M12 9v6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg>
                </div>
                <h3>Healing Package &mdash; 4 Sessions</h3>
                <p>Commit to consistent care with four full sessions booked over time, at a reduced rate.</p>
                <span class="service-price">4 x 60 min &middot; $320</span>
            </div>
            <div class="service-card">
                <div class="benefit-icon">
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 21s-6.5-4.1-9-8.6C1 8.6 2.9 5 6.5 5 9 5 10.8 6.3 12 8.1 13.2 6.3 15 5 17.5 5 21.1 5 23 8.6 21 12.4 18.5 16.9 12 21 12 21Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></svg>
                </div>
                <h3>Chakra Balancing Session</h3>
                <p>A focused session working through each energy center to restore flow and balance.</p>
                <span class="service-price">60 min &middot; $90</span>
            </div>
        </div>
    </div>
</section>

<section class="content-section alt" style="text-align:center">
    <div class="container">
        <div class="section-heading" style="margin-bottom:1.5rem">
            <span class="eyebrow">Not Sure Where to Start?</span>
            <h2>Let's Find the Right Session for You</h2>
        </div>
        <a class="btn btn-navy" href="contact">
            Schedule Now
            <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
    </div>
</section>
