@page "/schedule"
@using BlazorCalendar
@using BlazorCalendar.Models
@using System.Globalization
@using System.Text.Json
@implements IDisposable
@inject HttpClient Http
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<PageTitle>Session Calendar | Return to Self Reiki</PageTitle>

<section class="page-hero">
    <div class="container">
        <span class="eyebrow eyebrow--on-navy">Your Next Session</span>
        <h1>Session Calendar</h1>
        <p>A little time for yourself, with the practitioner you choose.</p>
        <a class="btn btn-cream" href="schedule#request-session">Request an appointment</a>
    </div>
</section>

<section class="content-section">
    <div class="container">
        <div class="session-calendar">
            <div class="calendar-practitioner">
                <label for="calendar-practitioner">Choose your practitioner</label>
                <select id="calendar-practitioner" @bind="practitionerId" @bind:after="LoadServicesAsync" disabled="@(bookingBusy || practitioners.Length == 0)">
                    @foreach (var person in practitioners)
                    {
                        <option value="@person.PractitionerId">@person.DisplayName</option>
                    }
                </select>
            </div>

            @if (services.Length > 0)
            {
                <div class="calendar-practitioner">
                    <label for="calendar-service">Choose your session</label>
                    <select id="calendar-service" @bind="serviceId" @bind:after="LoadAvailabilityAsync" disabled="@bookingBusy">
                        @foreach (var service in services)
                        {
                            <option value="@service.ServiceId">@service.Name &mdash; @service.Price.ToString("C", CultureInfo.GetCultureInfo("en-US"))</option>
                        }
                    </select>
                </div>
                @if (services.FirstOrDefault(s => s.ServiceId == serviceId) is { } selectedService)
                {
                    <p>@selectedService.Description</p>
                    @if (selectedService.FirstTimeClientPrice is { } introductoryPrice)
                    {
                        <p>First-time clients with this practitioner: @introductoryPrice.ToString("C", CultureInfo.GetCultureInfo("en-US")). Eligibility and final price are confirmed by your practitioner.</p>
                    }
                }
            }

            <div class="calendar-toolbar">
                <h2 id="calendar-month" aria-live="polite">@month.ToString("MMMM yyyy")</h2>
                <div class="calendar-navigation" role="group" aria-label="Calendar navigation">
                    <button type="button" class="btn btn-navy" aria-label="Previous month" disabled="@(bookingBusy || month.Year == 2000 && month.Month == 1)" @onclick="() => ChangeMonthAsync(-1)">Previous</button>
                    <button type="button" class="btn btn-navy" disabled="@bookingBusy" @onclick="ShowCurrentMonth">Today</button>
                    <button type="button" class="btn btn-navy" aria-label="Next month" disabled="@(bookingBusy || month.Year == 2100 && month.Month == 12)" @onclick="() => ChangeMonthAsync(1)">Next</button>
                </div>
            </div>

            <p class="calendar-notice" role="status">
                @notice Times are shown in Central Time. Requests require practitioner approval and do not reserve a time.
            </p>
            @if (loadFailed)
            {
                <button type="button" class="btn btn-navy" @onclick="LoadPractitionersAsync">Try Again</button>
            }

            <div class="calendar-grid" role="region" aria-labelledby="calendar-month" tabindex="0">
                <CalendarContainer @key="(practitionerId, month, appointments)" FirstDate="month" DisplayedView="DisplayedView.Monthly" TasksList="appointments">
                    <MonthlyView WeekDaysColor="var(--cream-pale)" SaturdayColor="var(--cream)" SundayColor="var(--cream)"
                                 HeaderStyle="background:var(--navy);color:var(--text-on-navy)"
                                 DayClick="@(e => SelectCalendarDateAsync(e.Day))" TaskClick="@(e => SelectCalendarDateAsync(e.Day))"
                                 OutsideCurrentMonthClick="ChangeMonthAsync" />
                </CalendarContainer>
            </div>
            <div id="request-session" class="calendar-windows calendar-practitioner">
                <h2 @ref="requestHeading" tabindex="-1">Request an appointment</h2>
                @if (string.IsNullOrWhiteSpace(apiBaseUrl))
                {
                    <p class="calendar-notice" role="status">Online appointment requests are not available on this site yet. Dates and times will appear here when booking is connected.</p>
                }
                else if (loading || loadFailed)
                {
                    <p class="calendar-notice" role="status">@notice</p>
                }
                else if (!bookingEnabled)
                {
                    <p class="calendar-notice" role="status">This practitioner is not accepting online appointment requests yet.</p>
                }
                else if (slots.Length == 0)
                {
                    <p class="calendar-notice" role="status">No appointment times are available for this session this month. Try another month or session.</p>
                }
                else
                {
                    <p>@location. Please request at least @minimumNoticeHours hours in advance.</p>
                    <p>Click an available day on the calendar or choose a date below, then select a time to enter your contact details.</p>
                }
                @if (!string.IsNullOrEmpty(calendarSelectionNotice))
                {
                    <p class="calendar-notice" role="status">@calendarSelectionNotice</p>
                }
                <label for="calendar-date">Choose a date</label>
                <select id="calendar-date" @bind="selectedDate" @bind:after="ClearSelectedTime" disabled="@(bookingBusy || !bookingEnabled || slots.Length == 0)">
                    <option value="">Select a date</option>
                    @foreach (var date in slots.Select(s => LocalTime(s.StartAtUtc).Date).Distinct())
                    {
                        <option value="@date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@date.ToString("dddd, MMMM d")</option>
                    }
                </select>
                <label for="calendar-time">Choose a time</label>
                <select id="calendar-time" @bind="selectedStart" disabled="@(bookingBusy || string.IsNullOrEmpty(selectedDate))">
                    <option value="">Select a time</option>
                    @foreach (var slot in slots.Where(s => LocalTime(s.StartAtUtc).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) == selectedDate))
                    {
                        <option value="@slot.StartAtUtc.ToString("O")">@LocalTime(slot.StartAtUtc).ToString("h:mm tt") &ndash; @LocalTime(slot.EndAtUtc).ToString("h:mm tt")</option>
                    }
                </select>
                @if (slots.FirstOrDefault(s => s.StartAtUtc.ToString("O") == selectedStart) is { } selectedSlot)
                {
                    <BodyBalanceWebsite.Components.BookingRequestForm @key="(practitionerId, serviceId, selectedStart)"
                        ApiBaseUrl="@(apiBaseUrl!)" PractitionerId="practitionerId" ServiceId="serviceId"
                        StartAtUtc="selectedSlot.StartAtUtc"
                        BusyChanged="@(value => bookingBusy = value)"
                        OffersFirstVisitPrice="@(services.First(s => s.ServiceId == serviceId).FirstTimeClientPrice is not null)" />
                }
            </div>
            @if (appointments.Length > 0)
            {
                <div class="calendar-windows">
                    <h3>Available hours</h3>
                    <p>These are open time windows, not bookable session slots.</p>
                    <ul>
                        @foreach (var window in appointments)
                        {
                            <li>@window.DateStart.ToString("MMM d, h:mm tt") &ndash; @window.DateEnd.ToString("MMM d, h:mm tt")</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private Practitioner[] practitioners = [];
    private int practitionerId;
    private Service[] services = [];
    private int serviceId;
    private TimeWindow[] slots = [];
    private string selectedDate = "";
    private string selectedStart = "";
    private bool bookingEnabled;
    private bool bookingBusy;
    private bool loading;
    private ElementReference requestHeading;
    private string? calendarSelectionNotice;
    private string? location;
    private int minimumNoticeHours;
    private TimeZoneInfo timeZone = TimeZoneInfo.FindSystemTimeZoneById("America/Chicago");
    private DateTime month;
    private Tasks[] appointments = [];
    private string notice = "Availability is coming soon. Empty dates do not indicate available appointments.";
    private bool loadFailed;
    private bool disposed;
    private int requestVersion;
    private CancellationTokenSource? requestCancellation;
    private string? apiBaseUrl;

    protected override async Task OnInitializedAsync()
    {
        var today = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("America/Chicago"));
        month = new(today.Year, today.Month, 1);
        apiBaseUrl = Configuration["ScheduleApiBaseUrl"];
        var bookingSiteUrl = Configuration["BookingSiteUrl"];
        if (string.IsNullOrWhiteSpace(apiBaseUrl) && !string.IsNullOrWhiteSpace(bookingSiteUrl))
        {
            // Booking Hosting: Send static-site links and bookmarks to the connected calendar without a back-button loop.
            Navigation.NavigateTo($"{bookingSiteUrl.TrimEnd('/')}/schedule{new Uri(Navigation.Uri).Fragment}", forceLoad: true, replace: true);
            return;
        }
        if (!string.IsNullOrWhiteSpace(apiBaseUrl))
            await LoadPractitionersAsync();
        else
        {
            practitioners = [new(1, "Mary"), new(2, "Leslie")];
            practitionerId = 1;
        }
    }

    private async Task LoadPractitionersAsync()
    {
        loading = true;
        loadFailed = false;
        notice = "Loading practitioners.";
        var (version, token) = BeginRequest();
        try
        {
            var result = await Http.GetFromJsonAsync<Practitioner[]>($"{apiBaseUrl!.TrimEnd('/')}/practitioners", token) ?? [];
            if (disposed || version != requestVersion) return;
            practitioners = result;
            if (practitioners.Length == 0)
            {
                loading = false;
                notice = "No practitioners are available yet.";
                return;
            }
            if (!practitioners.Any(p => p.PractitionerId == practitionerId))
                practitionerId = practitioners[0].PractitionerId;
            await LoadServicesAsync();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException)
        {
            if (!disposed && version == requestVersion) SetLoadFailure();
        }
    }

    private async Task LoadServicesAsync()
    {
        if (string.IsNullOrWhiteSpace(apiBaseUrl) || practitionerId == 0) return;
        var (version, token) = BeginRequest();
        loading = true;
        calendarSelectionNotice = null;
        services = [];
        serviceId = 0;
        appointments = [];
        slots = [];
        selectedDate = selectedStart = "";
        bookingEnabled = false;
        notice = "Loading sessions.";
        try
        {
            var result = await Http.GetFromJsonAsync<Service[]>($"{apiBaseUrl.TrimEnd('/')}/practitioners/{practitionerId}/services", token) ?? [];
            if (disposed || version != requestVersion) return;
            services = result;
            serviceId = services.FirstOrDefault()?.ServiceId ?? 0;
            await LoadAvailabilityAsync();
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException)
        {
            if (!disposed && version == requestVersion) SetLoadFailure();
        }
    }

    private async Task LoadAvailabilityAsync()
    {
        if (string.IsNullOrWhiteSpace(apiBaseUrl) || practitionerId == 0) return;
        var (version, token) = BeginRequest();
        loading = true;
        calendarSelectionNotice = null;
        appointments = [];
        slots = [];
        selectedDate = selectedStart = "";
        bookingEnabled = false;
        loadFailed = false;
        notice = "Loading available hours.";
        try
        {
            var result = await Http.GetFromJsonAsync<AvailabilityResponse>(
                $"{apiBaseUrl.TrimEnd('/')}/practitioners/{practitionerId}/availability?month={month.ToString("yyyy-MM", CultureInfo.InvariantCulture)}{(serviceId > 0 ? $"&serviceId={serviceId}" : "")}", token)
                ?? throw new JsonException("Missing availability response.");
            if (disposed || version != requestVersion) return;
            var zone = TimeZoneInfo.FindSystemTimeZoneById(result.TimeZoneId == "Central Standard Time" ? "America/Chicago" : result.TimeZoneId);
            loading = false;
            timeZone = zone;
            slots = result.Slots;
            bookingEnabled = result.BookingEnabled;
            location = result.Location;
            minimumNoticeHours = result.MinimumNoticeHours;
            appointments = result.Windows.Select((window, index) => new Tasks
            {
                ID = index + 1,
                DateStart = TimeZoneInfo.ConvertTimeFromUtc(window.StartAtUtc.UtcDateTime, zone),
                DateEnd = TimeZoneInfo.ConvertTimeFromUtc(window.EndAtUtc.UtcDateTime, zone),
                Caption = "Available hours", Code = "Open", Color = "#ece2cd", ForeColor = "#22304a",
                NotBeDraggable = true
            }).ToArray();
            notice = appointments.Length == 0 ? "No available hours are published for this month." : "Available hours are shown below.";
            if (serviceId > 0 && slots.Length == 0)
                notice = "No session times are available for this service this month.";
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException)
        {
            if (!disposed && version == requestVersion) SetLoadFailure();
        }
    }

    // State Sync: Cancel obsolete requests and prevent slower responses overwriting a newer selection.
    private (int Version, CancellationToken Token) BeginRequest()
    {
        requestCancellation?.Cancel();
        requestCancellation?.Dispose();
        requestCancellation = new();
        return (++requestVersion, requestCancellation.Token);
    }

    private void SetLoadFailure()
    {
        loading = false;
        appointments = [];
        slots = [];
        bookingEnabled = false;
        loadFailed = true;
        notice = "We couldn't load the schedule. Please try again shortly.";
    }

    private async Task ChangeMonthAsync(int offset)
    {
        // Calendar Navigation: Adjacent-month clicks respect the same bounds and booking lock as the buttons.
        if (bookingBusy || month.Year == 2000 && month.Month == 1 && offset < 0
            || month.Year == 2100 && month.Month == 12 && offset > 0) return;
        month = month.AddMonths(offset);
        await LoadAvailabilityAsync();
    }

    private async Task ShowCurrentMonth()
    {
        var today = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("America/Chicago"));
        month = new(today.Year, today.Month, 1);
        await LoadAvailabilityAsync();
    }

    public void Dispose()
    {
        disposed = true;
        requestCancellation?.Cancel();
        requestCancellation?.Dispose();
    }

    private sealed record Practitioner(int PractitionerId, string DisplayName);
    private sealed record TimeWindow(DateTimeOffset StartAtUtc, DateTimeOffset EndAtUtc);
    private sealed record Service(int ServiceId, string Name, int DurationMinutes, decimal Price,
        string CurrencyCode, string? Description, decimal? RegularPrice, decimal? FirstTimeClientPrice);
    private sealed record AvailabilityResponse(TimeWindow[] Windows, TimeWindow[] Slots, string TimeZoneId,
        bool BookingEnabled, string? Location, int MinimumNoticeHours);

    private DateTime LocalTime(DateTimeOffset value) => TimeZoneInfo.ConvertTimeFromUtc(value.UtcDateTime, timeZone);
    private void ClearSelectedTime()
    {
        selectedStart = "";
        calendarSelectionNotice = null;
    }

    private async Task SelectCalendarDateAsync(DateTime day)
    {
        if (bookingBusy || disposed) return;
        ClearSelectedTime();
        selectedDate = bookingEnabled && slots.Any(s => LocalTime(s.StartAtUtc).Date == day.Date)
            ? day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) : "";
        if (bookingEnabled && string.IsNullOrEmpty(selectedDate))
            calendarSelectionNotice = $"No appointment times are available on {day:MMMM d} for this session. Choose another date.";
        // Focus: The heading is always rendered, so calendar clicks can reveal the controls without a render-timing hook.
        await requestHeading.FocusAsync();
    }
}
